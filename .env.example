# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/devangar_matrimony?schema=public"
# Random string, at least 32 characters (used to sign login cookies)
SESSION_SECRET=""
# Optional: public URL used in link previews and the sitemap
# SITE_URL="https://example.com"
# Optional: admin account created by `npm run db:seed`
# ADMIN_PHONE="+919000000000"
# ADMIN_PASSWORD=""

# ── SMS for one-time codes ────────────────────────────────────────
# msg91 | twilio | console. Development defaults to console (codes printed in the terminal);
# production refuses to sign anyone up until a provider is set.
# SMS_PROVIDER="msg91"
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""           # DLT-approved OTP flow template with an ##otp## variable
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+1..."
# ALLOW_CONSOLE_SMS="true"       # allow SMS_PROVIDER=console in production (demos only: codes go to the server log)
# OTP_CHANNEL="whatsapp"         # send codes by WhatsApp first, falling back to SMS_PROVIDER above
#                                  (or set SMS_PROVIDER="whatsapp" for WhatsApp only, with no SMS fallback)
# WHATSAPP_OTP_TEMPLATE="otp_code"  # Meta "Authentication" template: body {{1}} = code, plus a "Copy code" button
# WHATSAPP_OTP_LANG="en"         # language of that template (defaults to WHATSAPP_TEMPLATE_LANG)

# ── Staff sign-in ─────────────────────────────────────────────────
# Admins and moderators enter an SMS code after their password; sessions end after 30 idle minutes.
# STAFF_2FA="off"                # local demos only

# ── Photo storage ─────────────────────────────────────────────────
# Without a token, photos are stored in the database. With one, they go to Vercel Blob
# (always served through the app with access checks; blob URLs are never shown to browsers).
# BLOB_READ_WRITE_TOKEN=""
# BLOB_BASE_URL=""               # only if the store URL cannot be derived from the token
# PHOTO_STORAGE_KEY=""           # secret for blob path names (defaults to SESSION_SECRET; never change once set)
# PHOTO_URL_KEY=""               # signs CDN-cacheable photo links (defaults to a key derived from SESSION_SECRET)

# ── Payments (Razorpay) ───────────────────────────────────────────
# Without keys, checkout runs in no-charge demo mode (development, or PAYMENTS_DEMO=true).
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""     # Dashboard → Webhooks → /api/razorpay/webhook (order.paid, payment.captured, payment.failed)
# PAYMENTS_DEMO="true"           # allow demo checkout in production (for pitches only)

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE_LANG="en"
# WHATSAPP_TEMPLATE_LANG_TA=""   # e.g. "ta" once Tamil versions of the templates are approved; used for members who chose Tamil

# ── Scheduled jobs & encryption ───────────────────────────────────
# CRON_SECRET=""                 # Vercel Cron sends it as a Bearer token to /api/cron/*
# ID_DOC_KEY=""                  # 32+ chars; encrypts uploaded ID documents (defaults to a key derived from SESSION_SECRET)

# ── Monitoring ────────────────────────────────────────────────────
# SENTRY_DSN=""                  # server errors are reported to Sentry (no member data is sent)

# ── Email notifications (Resend) ──────────────────────────────────
# Without a key, emails are logged instead of sent.
# RESEND_API_KEY=""
# EMAIL_FROM="Devangar Matrimony <updates@your-domain.in>"
# EMAIL_REPLY_TO="support@your-domain.in"

# ── GST invoices ──────────────────────────────────────────────────
# BUSINESS_NAME=""
# BUSINESS_GSTIN=""
# BUSINESS_ADDRESS=""
# BUSINESS_EMAIL=""

# ── Extra security ────────────────────────────────────────────────
# ADMIN_IP_ALLOWLIST=""          # e.g. "203.0.113.7, 198.51.100.0/24": staff powers only from these IPs
# SECURITY_CONTACT_EMAIL=""      # shown in /.well-known/security.txt (defaults to the Support page)
# PWNED_PASSWORD_CHECK=""        # breached-password check (Have I Been Pwned); on in production, "off" to disable
# TURNSTILE_SITE_KEY=""          # Cloudflare Turnstile bot check on sign-up, login, password reset, contact form
# TURNSTILE_SECRET_KEY=""        # both keys needed; leave empty to switch the check off
