generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum ProfileFor {
  SELF
  SON
  DAUGHTER
  BROTHER
  SISTER
  RELATIVE
  FRIEND
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum Dosham {
  NO
  YES
  DONT_KNOW
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum PhotoVisibility {
  ALL_MEMBERS
  ACCEPTED_ONLY
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id             String     @id @default(cuid())
  phone          String     @unique
  email          String?    @unique
  passwordHash   String
  role           Role       @default(USER)
  phoneVerified  Boolean    @default(false)
  // Bumped on password change / "log out everywhere"; sessions carrying an older value are rejected.
  sessionVersion Int        @default(0)
  createdAt      DateTime   @default(now())
  lastLoginAt    DateTime?
  profile        Profile?
  otpCodes       OtpCode[]
  adminLogs      AdminLog[]
}

/**
 * Fixed-window counters for rate limiting; shared by all server instances.
 */
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  targetId  String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Profile {
  id     String @id @default(cuid())
  // Short public ID shown to members, e.g. DM10234
  code   String @unique
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileFor    ProfileFor
  name          String
  gender        Gender
  dateOfBirth   DateTime
  maritalStatus MaritalStatus
  heightCm      Int?
  motherTongue  String
  subSect       String?

  // Community & horoscope
  gothram    String?
  kuladeivam String?
  star       String?
  rasi       String?
  dosham     Dosham  @default(DONT_KNOW)
  birthPlace String?
  birthTime  String?

  // Education & career
  education    String
  occupation   String
  annualIncome String?

  // Location
  city    String
  state   String @default("Tamil Nadu")
  country String @default("India")

  // Family
  fatherOccupation String?
  motherOccupation String?
  siblings         String?
  about            String?

  // Partner preferences
  prefAgeMin        Int?
  prefAgeMax        Int?
  prefMaritalStatus MaritalStatus[]
  prefNotes         String?

  photoVisibility PhotoVisibility @default(ALL_MEMBERS)
  status          ProfileStatus   @default(PENDING)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  photos            Photo[]
  sentInterests     Interest[]    @relation("InterestFrom")
  receivedInterests Interest[]    @relation("InterestTo")
  shortlists        Shortlist[]   @relation("ShortlistOwner")
  shortlistedBy     Shortlist[]   @relation("ShortlistTarget")
  reportsMade       Report[]      @relation("ReportBy")
  reportsReceived   Report[]      @relation("ReportAgainst")
  blocksMade        Block[]       @relation("BlockBy")
  blocksReceived    Block[]       @relation("BlockAgainst")
  viewsMade         ProfileView[] @relation("ViewBy")
  viewsReceived     ProfileView[] @relation("ViewOf")

  @@index([status, gender, dateOfBirth])
  @@index([status, gender, updatedAt])
  @@index([status, gender, createdAt])
}

model Photo {
  id        String     @id @default(cuid())
  profileId String
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  isPrimary Boolean    @default(false)
  approved  Boolean    @default(false)
  createdAt DateTime   @default(now())
  // Image bytes live in a separate table so listing photos never loads them.
  blob      PhotoBlob?

  @@index([profileId])
  @@index([approved, createdAt])
}

/**
 * Re-encoded WebP renditions; EXIF (including GPS) is stripped on upload.
 */
model PhotoBlob {
  photoId String @id
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  full    Bytes
  thumb   Bytes
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Profile  @relation("BlockBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Profile  @relation("BlockAgainst", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ProfileView {
  id       String   @id @default(cuid())
  viewerId String
  viewer   Profile  @relation("ViewBy", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedId String
  viewed   Profile  @relation("ViewOf", fields: [viewedId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([viewerId, viewedId])
  @@index([viewedId, viewedAt])
}

model Interest {
  id        String         @id @default(cuid())
  fromId    String
  from      Profile        @relation("InterestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Profile        @relation("InterestTo", fields: [toId], references: [id], onDelete: Cascade)
  message   String?
  status    InterestStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([fromId, toId])
  @@index([toId, status])
  @@index([fromId, createdAt])
}

model Shortlist {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Profile  @relation("ShortlistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    Profile  @relation("ShortlistTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, targetId])
  @@index([targetId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   Profile  @relation("ReportBy", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String
  target     Profile  @relation("ReportAgainst", fields: [targetId], references: [id], onDelete: Cascade)
  reason     String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([resolved, createdAt])
}
