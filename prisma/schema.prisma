generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  /// Staff who can moderate profiles, photos and reports, but not payments, ID documents or staff.
  MODERATOR
  ADMIN
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum UserStatus {
  ACTIVE
  /// Temporarily blocked from signing in until suspendedUntil (or until lifted).
  SUSPENDED
  /// Permanently blocked.
  BANNED
}

enum ReportCategory {
  FAKE_PROFILE
  HARASSMENT
  ALREADY_MARRIED
  ASKED_FOR_MONEY
  INAPPROPRIATE_CONTENT
  OTHER
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum ContactRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum IdDocType {
  AADHAAR
  PAN
  PASSPORT
  VOTER_ID
  DRIVING_LICENCE
  /// Live selfie compared against profile photos; approval sets Profile.photoVerifiedAt.
  SELFIE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FamilyRelation {
  FATHER
  MOTHER
  BROTHER
  SISTER
  GUARDIAN
  OTHER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  NOT_CONFIGURED
}

enum Gender {
  MALE
  FEMALE
}

enum ProfileFor {
  SELF
  SON
  DAUGHTER
  BROTHER
  SISTER
  RELATIVE
  FRIEND
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum Dosham {
  NO
  YES
  DONT_KNOW
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  /// Found their match; hidden from search and counted as a success.
  MARRIED
}

enum PhotoVisibility {
  ALL_MEMBERS
  ACCEPTED_ONLY
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id             String          @id @default(cuid())
  phone          String          @unique
  email          String?         @unique
  passwordHash   String
  role           Role            @default(USER)
  phoneVerified  Boolean         @default(false)
  // Bumped on password change / "log out everywhere"; sessions carrying an older value are rejected.
  sessionVersion Int             @default(0)
  createdAt      DateTime        @default(now())
  lastLoginAt    DateTime?
  /// Explicit consent to receive WhatsApp updates (required by WhatsApp and the DPDP Act).
  whatsappOptIn  Boolean         @default(false)
  profile        Profile?
  /// Set when this account is a family member managing someone else's profile.
  managing       ProfileManager?
  otpCodes       OtpCode[]
  adminLogs      AdminLog[]
  payments       Payment[]
  notifications  Notification[]

  status         UserStatus      @default(ACTIVE)
  statusReason   String?
  suspendedUntil DateTime?
  /// Updated at most every few minutes from authenticated requests.
  lastActiveAt   DateTime?
  emailOptIn     Boolean         @default(false)
  /// "en" or "ta".
  locale         String          @default("en")
  referralCode   String?         @unique
  referredById   String?
  referredBy     User?           @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      User[]          @relation("Referrals")
  loginEvents    LoginEvent[]
  securityEvents SecurityEvent[]
  tickets        SupportTicket[]
  ticketMessages TicketMessage[]

  @@index([createdAt])
  @@index([lastActiveAt])
}

/// Security-relevant events on an account, shown to the member in Settings ("Security activity").
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// new_device | password_changed | password_reset | signed_out_everywhere | locked_via_link | number_shared | email_changed | staff_signed_out | staff_password_reset
  kind      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// One row per successful sign-in: powers "devices", member timelines and multi-account detection.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Long-lived random id from the dm_device cookie.
  deviceId  String
  /// SHA-256 of the IP with SESSION_SECRET; raw IPs are not stored.
  ipHash    String
  userAgent String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deviceId])
}

/// Key/value configuration editable from the admin portal (plans, dropdown lists, feature switches, page content).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  /// Exactly one of percentOff / amountOff (paise) is set.
  percentOff Int?
  amountOff  Int?
  /// Plan ids it applies to; empty means all plans.
  plans      String[]
  maxUses    Int?
  uses       Int       @default(0)
  expiresAt  DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  /// Optional link shown as a button.
  href        String?
  /// all | free | premium | male | female | staff
  audience    String    @default("all")
  active      Boolean   @default(true)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([active, startsAt])
}

model SupportTicket {
  id        String          @id @default(cuid())
  /// Null for messages sent from the public contact form while signed out.
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String?
  email     String?
  subject   String
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  TicketMessage[]

  @@index([status, updatedAt])
  @@index([userId])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromStaff Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model SuccessStory {
  id          String    @id @default(cuid())
  coupleNames String
  story       String
  city        String?
  weddingDate DateTime?
  photo       Bytes?
  photoMime   String?
  published   Boolean   @default(false)
  /// Member who submitted it, if any.
  profileId   String?
  createdAt   DateTime  @default(now())

  @@index([published, createdAt])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String
  startsAt    DateTime
  endsAt      DateTime?
  href        String?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([published, startsAt])
}

model SavedSearch {
  id             String    @id @default(cuid())
  profileId      String
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String
  /// The search page's query-string parameters.
  params         Json
  alert          Boolean   @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([profileId])
}

/// Chat messages between two members; only allowed once an interest between them is accepted.
model Message {
  id         String    @id @default(cuid())
  interestId String
  interest   Interest  @relation(fields: [interestId], references: [id], onDelete: Cascade)
  senderId   String
  sender     Profile   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([interestId, createdAt])
  @@index([senderId])
}

/// A request to see a member's phone number; the number is shown only after they approve.
model ContactRequest {
  id          String               @id @default(cuid())
  fromId      String
  from        Profile              @relation("ContactFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          Profile              @relation("ContactTo", fields: [toId], references: [id], onDelete: Cascade)
  status      ContactRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  respondedAt DateTime?

  @@unique([fromId, toId])
  @@index([toId, status])
}

/// Uploaded horoscope (jathagam), PDF or image, stored separately so profile queries never load it.
model Horoscope {
  profileId  String   @id
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  data       Bytes
  mime       String
  uploadedAt DateTime @default(now())
}

/// A family member's account with access to manage another member's profile.
model ProfileManager {
  id        String         @id @default(cuid())
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation  FamilyRelation
  createdAt DateTime       @default(now())

  @@index([profileId])
}

/// Pending invitation, bound to the invitee's mobile number (proven by OTP when they register).
model FamilyInvite {
  id        String         @id @default(cuid())
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  phone     String
  relation  FamilyRelation
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@unique([profileId, phone])
  @@index([phone])
}

model Payment {
  id                String        @id @default(cuid())
  /// Kept (unlinked) after account deletion: payment records must be retained for tax purposes.
  profileId         String?
  profile           Profile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  paidById          String?
  paidBy            User?         @relation(fields: [paidById], references: [id], onDelete: SetNull)
  plan              String
  months            Int
  /// Amount in paise.
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  /// True for no-charge demo checkouts used before Razorpay keys are configured.
  demo              Boolean       @default(false)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  createdAt         DateTime      @default(now())
  paidAt            DateTime?
  couponCode        String?
  /// Discount applied, in paise.
  discount          Int           @default(0)
  /// Sequential GST invoice number, e.g. DM/2026-27/000123; assigned when paid.
  invoiceNumber     String?       @unique
  failureReason     String?
  refundedAt        DateTime?
  /// Refunded amount in paise.
  refundAmount      Int?
  refundId          String?
  /// Premium granted by an admin (cash / bank transfer / goodwill) rather than online checkout.
  offline           Boolean       @default(false)
  grantedById       String?

  @@index([profileId, createdAt])
  @@index([status, paidAt])
}

model IdVerification {
  id              String             @id @default(cuid())
  profileId       String
  profile         Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  docType         IdDocType
  /// Only the last four characters are ever stored.
  last4           String
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  /// AES-256-GCM encrypted document; set to null as soon as it is reviewed.
  document        Bytes?
  documentMime    String?
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedById    String?

  @@index([status, createdAt])
  @@index([profileId])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  String
  params    Json
  channel   NotificationChannel @default(WHATSAPP)
  status    NotificationStatus  @default(PENDING)
  error     String?
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  @@index([userId, template, createdAt])
  @@index([createdAt])
}

/**
 * Fixed-window counters for rate limiting; shared by all server instances.
 */
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  targetId  String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  /// "verify" (phone verification / password reset) or "staff_login" (second step for staff).
  purpose   String   @default("verify")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Profile {
  id     String @id @default(cuid())
  // Short public ID shown to members, e.g. DM10234
  code   String @unique
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileFor    ProfileFor
  name          String
  gender        Gender
  dateOfBirth   DateTime
  maritalStatus MaritalStatus
  heightCm      Int?
  motherTongue  String
  subSect       String?

  // Community & horoscope
  gothram    String?
  kuladeivam String?
  star       String?
  rasi       String?
  dosham     Dosham  @default(DONT_KNOW)
  birthPlace String?
  birthTime  String?
  lagnam     String?

  // Education & career
  education    String
  occupation   String
  annualIncome String?

  // Location
  city    String
  state   String @default("Tamil Nadu")
  country String @default("India")

  // Family
  fatherOccupation String?
  motherOccupation String?
  siblings         String?
  fatherName       String?
  motherName       String?
  familyType       String?
  familyStatus     String?
  nativePlace      String?
  about            String?

  // Lifestyle
  diet       String?
  complexion String?
  languages  String[]

  // Partner preferences
  prefAgeMin            Int?
  prefAgeMax            Int?
  prefMaritalStatus     MaritalStatus[]
  prefNotes             String?
  /// Same-gothram marriages are traditionally avoided; on by default.
  prefExcludeOwnGothram Boolean         @default(true)
  prefStars             String[]
  prefDosham            Dosham?
  prefCities            String[]
  prefEducation         String?

  /// Premium membership end date; null or past means free.
  premiumUntil        DateTime?
  /// Set when an ID document has been approved by an admin.
  idVerifiedAt        DateTime?
  /// Set when a selfie check has been approved.
  photoVerifiedAt     DateTime?
  marriedAt           DateTime?
  /// Automatic moderation flags (e.g. "contact_info", "duplicate_photo", "shared_device", "interest_spike").
  flags               String[]
  /// Staff-only internal notes.
  staffNotes          String?
  horoscopeVisibility PhotoVisibility @default(ACCEPTED_ONLY)
  photoVisibility     PhotoVisibility @default(ALL_MEMBERS)
  status              ProfileStatus   @default(PENDING)
  rejectionReason     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  photos            Photo[]
  sentInterests     Interest[]       @relation("InterestFrom")
  receivedInterests Interest[]       @relation("InterestTo")
  shortlists        Shortlist[]      @relation("ShortlistOwner")
  shortlistedBy     Shortlist[]      @relation("ShortlistTarget")
  reportsMade       Report[]         @relation("ReportBy")
  reportsReceived   Report[]         @relation("ReportAgainst")
  blocksMade        Block[]          @relation("BlockBy")
  blocksReceived    Block[]          @relation("BlockAgainst")
  viewsMade         ProfileView[]    @relation("ViewBy")
  viewsReceived     ProfileView[]    @relation("ViewOf")
  managers          ProfileManager[]
  familyInvites     FamilyInvite[]
  payments          Payment[]
  idVerifications   IdVerification[]
  horoscope         Horoscope?
  savedSearches     SavedSearch[]
  messagesSent      Message[]        @relation("MessageSender")
  contactsSent      ContactRequest[] @relation("ContactFrom")
  contactsReceived  ContactRequest[] @relation("ContactTo")

  @@index([status, createdAt])
  @@index([status, gender, dateOfBirth])
  @@index([status, gender, updatedAt])
  @@index([status, gender, createdAt])
}

model Photo {
  id        String     @id @default(cuid())
  profileId String
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  isPrimary Boolean    @default(false)
  approved  Boolean    @default(false)
  /// 64-bit perceptual (average) hash as hex, for duplicate-photo detection across accounts.
  hash      String?
  createdAt DateTime   @default(now())
  // Image bytes live in a separate table so listing photos never loads them.
  blob      PhotoBlob?

  @@index([profileId])
  @@index([approved, createdAt])
  @@index([hash])
}

/**
 * Re-encoded WebP renditions; EXIF (including GPS) is stripped on upload.
 */
model PhotoBlob {
  photoId String @id
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  full    Bytes
  thumb   Bytes
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Profile  @relation("BlockBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Profile  @relation("BlockAgainst", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ProfileView {
  id       String   @id @default(cuid())
  viewerId String
  viewer   Profile  @relation("ViewBy", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedId String
  viewed   Profile  @relation("ViewOf", fields: [viewedId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([viewerId, viewedId])
  @@index([viewedId, viewedAt])
}

model Interest {
  id        String         @id @default(cuid())
  fromId    String
  from      Profile        @relation("InterestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Profile        @relation("InterestTo", fields: [toId], references: [id], onDelete: Cascade)
  message   String?
  status    InterestStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  Message[]

  @@unique([fromId, toId])
  @@index([toId, status])
  @@index([fromId, createdAt])
}

model Shortlist {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Profile  @relation("ShortlistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    Profile  @relation("ShortlistTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, targetId])
  @@index([targetId])
}

model Report {
  id           String         @id @default(cuid())
  reporterId   String
  reporter     Profile        @relation("ReportBy", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId     String
  target       Profile        @relation("ReportAgainst", fields: [targetId], references: [id], onDelete: Cascade)
  reason       String
  category     ReportCategory @default(OTHER)
  /// 1 = high, 2 = normal, 3 = low.
  priority     Int            @default(2)
  /// Internal staff notes.
  notes        String?
  resolved     Boolean        @default(false)
  resolution   String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime       @default(now())

  @@index([resolved, createdAt])
}
