generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  /// Staff who can moderate profiles, photos and reports, but not payments, ID documents or staff.
  MODERATOR
  ADMIN
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum IdDocType {
  AADHAAR
  PAN
  PASSPORT
  VOTER_ID
  DRIVING_LICENCE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FamilyRelation {
  FATHER
  MOTHER
  BROTHER
  SISTER
  GUARDIAN
  OTHER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  NOT_CONFIGURED
}

enum Gender {
  MALE
  FEMALE
}

enum ProfileFor {
  SELF
  SON
  DAUGHTER
  BROTHER
  SISTER
  RELATIVE
  FRIEND
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum Dosham {
  NO
  YES
  DONT_KNOW
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum PhotoVisibility {
  ALL_MEMBERS
  ACCEPTED_ONLY
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id             String          @id @default(cuid())
  phone          String          @unique
  email          String?         @unique
  passwordHash   String
  role           Role            @default(USER)
  phoneVerified  Boolean         @default(false)
  // Bumped on password change / "log out everywhere"; sessions carrying an older value are rejected.
  sessionVersion Int             @default(0)
  createdAt      DateTime        @default(now())
  lastLoginAt    DateTime?
  /// Explicit consent to receive WhatsApp updates (required by WhatsApp and the DPDP Act).
  whatsappOptIn  Boolean         @default(false)
  profile        Profile?
  /// Set when this account is a family member managing someone else's profile.
  managing       ProfileManager?
  otpCodes       OtpCode[]
  adminLogs      AdminLog[]
  payments       Payment[]
  notifications  Notification[]
}

/// A family member's account with access to manage another member's profile.
model ProfileManager {
  id        String         @id @default(cuid())
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation  FamilyRelation
  createdAt DateTime       @default(now())

  @@index([profileId])
}

/// Pending invitation, bound to the invitee's mobile number (proven by OTP when they register).
model FamilyInvite {
  id        String         @id @default(cuid())
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  phone     String
  relation  FamilyRelation
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@unique([profileId, phone])
  @@index([phone])
}

model Payment {
  id                String        @id @default(cuid())
  /// Kept (unlinked) after account deletion: payment records must be retained for tax purposes.
  profileId         String?
  profile           Profile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)
  paidById          String?
  paidBy            User?         @relation(fields: [paidById], references: [id], onDelete: SetNull)
  plan              String
  months            Int
  /// Amount in paise.
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  /// True for no-charge demo checkouts used before Razorpay keys are configured.
  demo              Boolean       @default(false)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  createdAt         DateTime      @default(now())
  paidAt            DateTime?

  @@index([profileId, createdAt])
  @@index([status, paidAt])
}

model IdVerification {
  id              String             @id @default(cuid())
  profileId       String
  profile         Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  docType         IdDocType
  /// Only the last four characters are ever stored.
  last4           String
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  /// AES-256-GCM encrypted document; set to null as soon as it is reviewed.
  document        Bytes?
  documentMime    String?
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedById    String?

  @@index([status, createdAt])
  @@index([profileId])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  String
  params    Json
  status    NotificationStatus @default(PENDING)
  error     String?
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  @@index([userId, template, createdAt])
  @@index([createdAt])
}

/**
 * Fixed-window counters for rate limiting; shared by all server instances.
 */
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  targetId  String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Profile {
  id     String @id @default(cuid())
  // Short public ID shown to members, e.g. DM10234
  code   String @unique
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileFor    ProfileFor
  name          String
  gender        Gender
  dateOfBirth   DateTime
  maritalStatus MaritalStatus
  heightCm      Int?
  motherTongue  String
  subSect       String?

  // Community & horoscope
  gothram    String?
  kuladeivam String?
  star       String?
  rasi       String?
  dosham     Dosham  @default(DONT_KNOW)
  birthPlace String?
  birthTime  String?

  // Education & career
  education    String
  occupation   String
  annualIncome String?

  // Location
  city    String
  state   String @default("Tamil Nadu")
  country String @default("India")

  // Family
  fatherOccupation String?
  motherOccupation String?
  siblings         String?
  about            String?

  // Partner preferences
  prefAgeMin        Int?
  prefAgeMax        Int?
  prefMaritalStatus MaritalStatus[]
  prefNotes         String?

  /// Premium membership end date; null or past means free.
  premiumUntil    DateTime?
  /// Set when an ID document has been approved by an admin.
  idVerifiedAt    DateTime?
  photoVisibility PhotoVisibility @default(ALL_MEMBERS)
  status          ProfileStatus   @default(PENDING)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  photos            Photo[]
  sentInterests     Interest[]       @relation("InterestFrom")
  receivedInterests Interest[]       @relation("InterestTo")
  shortlists        Shortlist[]      @relation("ShortlistOwner")
  shortlistedBy     Shortlist[]      @relation("ShortlistTarget")
  reportsMade       Report[]         @relation("ReportBy")
  reportsReceived   Report[]         @relation("ReportAgainst")
  blocksMade        Block[]          @relation("BlockBy")
  blocksReceived    Block[]          @relation("BlockAgainst")
  viewsMade         ProfileView[]    @relation("ViewBy")
  viewsReceived     ProfileView[]    @relation("ViewOf")
  managers          ProfileManager[]
  familyInvites     FamilyInvite[]
  payments          Payment[]
  idVerifications   IdVerification[]

  @@index([status, gender, dateOfBirth])
  @@index([status, gender, updatedAt])
  @@index([status, gender, createdAt])
}

model Photo {
  id        String     @id @default(cuid())
  profileId String
  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  isPrimary Boolean    @default(false)
  approved  Boolean    @default(false)
  createdAt DateTime   @default(now())
  // Image bytes live in a separate table so listing photos never loads them.
  blob      PhotoBlob?

  @@index([profileId])
  @@index([approved, createdAt])
}

/**
 * Re-encoded WebP renditions; EXIF (including GPS) is stripped on upload.
 */
model PhotoBlob {
  photoId String @id
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  full    Bytes
  thumb   Bytes
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Profile  @relation("BlockBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Profile  @relation("BlockAgainst", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ProfileView {
  id       String   @id @default(cuid())
  viewerId String
  viewer   Profile  @relation("ViewBy", fields: [viewerId], references: [id], onDelete: Cascade)
  viewedId String
  viewed   Profile  @relation("ViewOf", fields: [viewedId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([viewerId, viewedId])
  @@index([viewedId, viewedAt])
}

model Interest {
  id        String         @id @default(cuid())
  fromId    String
  from      Profile        @relation("InterestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Profile        @relation("InterestTo", fields: [toId], references: [id], onDelete: Cascade)
  message   String?
  status    InterestStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([fromId, toId])
  @@index([toId, status])
  @@index([fromId, createdAt])
}

model Shortlist {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Profile  @relation("ShortlistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    Profile  @relation("ShortlistTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, targetId])
  @@index([targetId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   Profile  @relation("ReportBy", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String
  target     Profile  @relation("ReportAgainst", fields: [targetId], references: [id], onDelete: Cascade)
  reason     String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([resolved, createdAt])
}
